        "# === (B1 CORREGIDA) Preparar base mensual (auto-detección de fecha) ===\n",
        "import re\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "# Helper para detectar columnas por patrón\n",
        "def first_matching_col(df, patterns):\n",
        "    cols = list(df.columns)\n",
        "    low  = [c.lower() for c in cols]\n",
        "    for pat in patterns:\n",
        "        rx = re.compile(pat)\n",
        "        for c, cl in zip(cols, low):\n",
        "            if rx.search(cl):\n",
        "                return c\n",
        "    return None\n",
        "\n",
        "# 1) Detectar columna de fecha en df_reviews\n",
        "date_pats = [\n",
        "    r'^(review_)?date(s)?$', r'fecha', r'timestamp', r'created(_at)?', r'post(ed)?_at',\n",
        "    r'update(d)?_at', r'^date$'\n",
        "]\n",
        "date_col = first_matching_col(df_reviews, date_pats)\n",
        "print(\"Columna de fecha detectada en reviews:\", date_col)\n",
        "assert date_col is not None, \"No pude detectar una columna de fecha en df_reviews. Ajusta 'date_pats'.\"\n",
        "\n",
        "# 2) Parseo a datetime y filtrado mínimo\n",
        "rev = df_reviews.copy()\n",
        "rev['review_dt'] = pd.to_datetime(rev[date_col], errors='coerce')\n",
        "rev = rev.loc[rev['review_dt'].notna() & rev['score_overall'].notna()].copy()\n",
        "\n",
        "# Período mensual (YYYY-MM)\n",
        "rev['ym'] = rev['review_dt'].dt.to_period('M').astype(str)\n",
        "\n",
        "# 3) Agregación mensual (¡sin .to_frame()!)\n",
        "monthly = (\n",
        "    rev.groupby('ym', as_index=True)['score_overall']\n",
        "       .agg(mean='mean', median='median', sd='std', n='size')\n",
        ")\n",
        "\n",
        "# Porcentajes de extremos\n",
        "monthly['p_high'] = rev.groupby('ym')['score_overall'].apply(lambda s: (s >= 9).mean())\n",
        "monthly['p_low']  = rev.groupby('ym')['score_overall'].apply(lambda s: (s <= 3).mean())\n",
        "\n",
        "# IC95% para la media (normal aprox.)\n",
        "monthly['sd'] = monthly['sd'].fillna(0)\n",
        "monthly['se'] = monthly['sd'] / np.sqrt(monthly['n'].clip(lower=1))\n",
        "monthly['ci95'] = 1.96 * monthly['se']\n",
        "\n",
        "# Media móvil 3M (suavizado)\n",
        "monthly['roll3'] = monthly['mean'].rolling(3, min_periods=1).mean()\n",
        "\n",
        "# 4) Z-score robusto (MAD) para detectar atípicos en la media mensual\n",
        "med = monthly['mean'].median()\n",
        "mad = np.median(np.abs(monthly['mean'] - med))\n",
        "monthly['z_mad'] = 0.0 if mad == 0 else 0.6745 * (monthly['mean'] - med) / mad\n",
        "\n",
        "# Regla de atípicos (|z|>=3) y umbral mínimo de n por mes para estabilidad\n",
        "MIN_N = 50\n",
        "monthly['is_outlier'] = (monthly['n'] >= MIN_N) & (monthly['z_mad'].abs() >= 3)\n",
        "\n",
        "print(\"Meses totales:\", len(monthly), \"| con n >= MIN_N:\", int((monthly['n']>=MIN_N).sum()))\n",
        "print(\"Atípicos detectados (|z|>=3):\", int(monthly['is_outlier'].sum()))\n",
        "monthly.head()\n"
      ],
