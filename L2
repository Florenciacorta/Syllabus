        "# 🧪 Celda de código (D2) — Coherencia “ubicación real” vs. score_location (robusta)\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# --- 0) Utilidad: z-score con MAD ---\n",
        "def z_mad(x):\n",
        "    x = np.asarray(x, dtype=float)\n",
        "    med = np.nanmedian(x)\n",
        "    mad = np.nanmedian(np.abs(x - med))\n",
        "    if mad == 0:\n",
        "        sd = np.nanstd(x, ddof=0)\n",
        "        return (x - np.nanmean(x))/sd if sd > 0 else np.zeros_like(x)\n",
        "    return 0.6745*(x - med)/mad\n",
        "\n",
        "# --- 1) Chequeos y limpieza básica ---\n",
        "required_cols = ['dist_z', 'score_loc_mean']\n",
        "for c in required_cols:\n",
        "    assert c in base.columns, f\"Falta la columna '{c}' en 'base'. Corre la celda D1 antes.\"\n",
        "\n",
        "dat = base[required_cols].replace([np.inf, -np.inf], np.nan).dropna().copy()\n",
        "assert len(dat) >= 2, \"Insuficientes datos válidos para ajustar la relación global.\"\n",
        "\n",
        "# --- 2) Resumen por ciudad (si la tenemos) ---\n",
        "city_candidates = [c for c in ['__city__','city','ciudad','town'] if c in base.columns]\n",
        "city_use = city_candidates[0] if city_candidates else None\n",
        "\n",
        "def _city_stats(df):\n",
        "    sub = df[['dist_z','score_loc_mean']].replace([np.inf,-np.inf], np.nan).dropna()\n",
        "    out = {}\n",
        "    out['n_hotels'] = len(sub)\n",
        "    if len(sub) >= 4 and sub['dist_z'].std() > 0 and sub['score_loc_mean'].std() > 0:\n",
        "        out['r_pear']  = sub['dist_z'].corr(sub['score_loc_mean'])\n",
        "        out['r_spear'] = sub['dist_z'].corr(sub['score_loc_mean'], method='spearman')\n",
        "        x, y = sub['dist_z'].values, sub['score_loc_mean'].values\n",
        "        out['slope']   = np.cov(x, y, ddof=0)[0,1] / np.var(x, ddof=0)\n",
        "    else:\n",
        "        out['r_pear']  = np.nan\n",
        "        out['r_spear'] = np.nan\n",
        "        out['slope']   = np.nan\n",
        "    return pd.Series(out)\n",
        "\n",
        "if city_use:\n",
        "    by_city = (base\n",
        "               .groupby(city_use, as_index=False)\n",
        "               .apply(_city_stats)\n",
        "               .rename(columns={city_use:'city'}))\n",
        "    print(\"=== Resumen por ciudad (solo interpretativas) ===\")\n",
        "    display(by_city.sort_values('r_pear', na_position='last'))\n",
        "else:\n",
        "    print(\"No hay columna de ciudad en 'base'; se omite el resumen por ciudad.\")\n",
        "    by_city = pd.DataFrame()\n",
        "\n",
        "# --- 3) Relación global: score_loc_mean ~ dist_z (lineal simple, robusta) ---\n",
        "if dat['dist_z'].std() > 0:\n",
        "    x, y = dat['dist_z'].values, dat['score_loc_mean'].values\n",
        "    slope = np.cov(x, y, ddof=0)[0,1] / np.var(x, ddof=0)\n",
        "    intercept = float(y.mean() - slope * x.mean())\n",
        "else:\n",
        "    # si no hay varianza en dist_z, la mejor predicción es la media de y\n",
        "    slope = 0.0\n",
        "    intercept = float(dat['score_loc_mean'].mean())\n",
        "\n",
        "base['pred']  = intercept + slope * base['dist_z']\n",
        "base['resid'] = base['score_loc_mean'] - base['pred']\n",
        "base['z_res'] = z_mad(base['resid'])\n",
        "\n",
        "print(\"=== Ajuste global ===\")\n",
        "print(f\"n válidos = {len(dat)} | pendiente(slope) = {slope:+.4f} | intercepto = {intercept:.4f}\")\n",
        "print(f\"corr Pearson = {dat['dist_z'].corr(dat['score_loc_mean']):+.3f} | \"\n",
        "      f\"corr Spearman = {dat['dist_z'].corr(dat['score_loc_mean'], method='spearman'):+.3f}\")\n",
        "\n",
        "# --- 4) Outliers por residuo (|z_res| >= 3) ---\n",
        "THR = 3.0\n",
        "outliers = (base.loc[base['z_res'].abs() >= THR,\n",
        "                     ['hotel_id','hotel_name','dist_km','dist_z','score_loc_mean','pred','resid','z_res','n']]\n",
        "            .copy()\n",
        "            .sort_values('z_res'))\n",
        "print(f\"Outliers por residuo (|z_res| ≥ {THR}): {len(outliers)}\")\n",
        "display(outliers)\n",
        "\n",
        "# --- 5) Gráficos ---\n",
        "valid = base[['dist_z','score_loc_mean']].replace([np.inf,-np.inf], np.nan).dropna()\n",
        "plt.figure(figsize=(6,4))\n",
        "plt.scatter(valid['dist_z'], valid['score_loc_mean'], alpha=0.8)\n",
        "xx = np.linspace(valid['dist_z'].min(), valid['dist_z'].max(), 100)\n",
        "yy = intercept + slope*xx\n",
        "plt.plot(xx, yy, linestyle='--', label='Ajuste lineal')\n",
        "plt.xlabel('Distancia normalizada al centro (dist_z)')\n",
        "plt.ylabel('Media score_location')\n",
        "plt.title('score_location vs. distancia (global)')\n",
        "plt.legend()\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# Barras de outliers (si existen)\n",
        "if len(outliers) > 0:\n",
        "    topN = outliers.reindex(outliers['z_res'].abs().sort_values(ascending=False).index).head(12)\n",
        "    plt.figure(figsize=(7,4))\n",
        "    plt.barh(topN['hotel_name'], topN['z_res'])\n",
        "    plt.axvline(0, linestyle='--')\n",
        "    plt.xlabel('z_res (residuo estandarizado)')\n",
        "    plt.title('Hoteles “atípicos” según residuo (|z| ≥ 3)')\n",
        "    plt.gca().invert_yaxis()\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n"
      ],
