        "# Medias crudas vs. filtradas por hotel\n",
        "by_hotel = (rev\n",
        "            .groupby('hotel_id')\n",
        "            .agg(raw_mean=('score_overall','mean'),\n",
        "                 clean_mean=('is_suspicious', lambda s: np.nan)) # placeholder\n",
        "           ).reset_index()\n",
        "\n",
        "# Recalcular clean_mean sin reseñas sospechosas\n",
        "clean = (rev.loc[~rev['is_suspicious']]\n",
        "         .groupby('hotel_id')['score_overall']\n",
        "         .mean()\n",
        "         .rename('clean_mean'))\n",
        "by_hotel = by_hotel.drop(columns='clean_mean').merge(clean, on='hotel_id', how='left')\n",
        "\n",
        "# Completar faltantes (si un hotel no tiene reseñas “no sospechosas”, dejar NaN)\n",
        "by_hotel['delta'] = by_hotel['clean_mean'] - by_hotel['raw_mean']\n",
        "\n",
        "# Adjuntar nombre de hotel si existe\n",
        "name_col = first_col(df_hotels, [r'hotel[_ ]?name', r'\\bname\\b', r'title'])\n",
        "hot_names = df_hotels[['hotel_id', name_col]].rename(columns={name_col:'hotel_name'}) if name_col in df_hotels.columns else None\n",
        "if hot_names is not None:\n",
        "    by_hotel = by_hotel.merge(hot_names, on='hotel_id', how='left')\n",
        "\n",
        "# Ranking crudo vs. limpio (desc: mayor es mejor)\n",
        "by_hotel['rank_raw']   = by_hotel['raw_mean'].rank(ascending=False, method='dense')\n",
        "by_hotel['rank_clean'] = by_hotel['clean_mean'].rank(ascending=False, method='dense')\n",
        "by_hotel['rank_shift'] = by_hotel['rank_clean'] - by_hotel['rank_raw']\n",
        "\n",
        "# Resumen\n",
        "print(\"=== Resumen impacto por hotel ===\")\n",
        "print(f\"Hoteles con delta válido: {by_hotel['delta'].notna().sum()} / {len(by_hotel)}\")\n",
        "print(f\"Δ promedio (clean - raw): {by_hotel['delta'].mean():+.4f}\")\n",
        "print(f\"|Δ| mediana: {by_hotel['delta'].abs().median():.4f}\")\n",
        "\n",
        "# Top cambios absolutos\n",
        "top_abs = (by_hotel.dropna(subset=['delta'])\n",
