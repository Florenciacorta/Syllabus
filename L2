      "source": [
        "import numpy as np\n",
        "import pandas as pd\n",
        "import re\n",
        "\n",
        "# ---------- Helpers ----------\n",
        "def first_col(df, pats):\n",
        "    cols = list(df.columns)\n",
        "    cl = [c.lower() for c in cols]\n",
        "    for pat in pats:\n",
        "        rx = re.compile(pat, re.I)\n",
        "        for c, lc in zip(cols, cl):\n",
        "            if rx.search(lc):\n",
        "                return c\n",
        "    return None\n",
        "\n",
        "# Columnas claves (auto-detección robusta)\n",
        "col_score = first_col(df_reviews, [r'^score_?overall$', r'overall', r'global'])\n",
        "col_date  = first_col(df_reviews, [r'date', r'review_?date', r'fecha'])\n",
        "col_user  = first_col(df_reviews, [r'^user_?id$'])\n",
        "col_hotel = first_col(df_reviews, [r'^hotel_?id$'])\n",
        "assert all([col_score, col_date, col_user, col_hotel]), \"No pude detectar columnas clave en reviews.\"\n",
        "\n",
        "# Copia de trabajo\n",
        "rev = df_reviews[[col_user, col_hotel, col_date, col_score]].rename(columns={\n",
        "    col_user:'user_id', col_hotel:'hotel_id', col_date:'date', col_score:'score_overall'\n",
        "}).copy()\n",
        "\n",
        "# Parseo de fecha\n",
        "rev['date'] = pd.to_datetime(rev['date'], errors='coerce')\n",
        "\n",
        "# -------------- Flag 1: usuarios “constantes” --------------\n",
        "user_stats = (rev\n",
        "              .groupby('user_id')['score_overall']\n",
        "              .agg(['count','mean','std'])\n",
        "              .rename(columns={'count':'n'}))\n",
        "\n",
        "user_stats['std'] = user_stats['std'].fillna(0.0)\n",
        "flag_user_hi = (user_stats['std'] < 0.2) & (user_stats['mean'] >= 9.0)\n",
        "flag_user_lo = (user_stats['std'] < 0.2) & (user_stats['mean'] <= 4.0)\n",
        "susp_users = pd.Index(user_stats.index[flag_user_hi | flag_user_lo])\n",
        "\n",
        "# -------------- Flag 2: usuario califica ≥3 hoteles el mismo día --------------\n",
        "tmp_ud = (rev.assign(day=rev['date'].dt.date)\n",
        "            .groupby(['user_id','day'])['hotel_id']\n",
        "            .nunique()\n",
        "            .reset_index(name='hotels_that_day'))\n",
        "susp_user_day = tmp_ud.loc[tmp_ud['hotels_that_day'] >= 3, ['user_id','day']]\n",
        "susp_user_day['day'] = pd.to_datetime(susp_user_day['day'])\n",
        "\n",
        "# -------------- Flag 3: bursts por hotel/día (z-MAD sobre conteos diarios) --------------\n",
        "daily_counts = (rev\n",
        "                .assign(day=rev['date'].dt.date)\n",
        "                .groupby(['hotel_id','day'])\n",
        "                .size()\n",
        "                .reset_index(name='n'))\n",
        "def z_mad(x):\n",
        "    med = np.median(x)\n",
        "    mad = np.median(np.abs(x - med))\n",
        "    return (x - med) / (1.4826 * mad) if mad > 0 else np.zeros_like(x, dtype=float)\n",
        "\n",
        "daily_counts['zmad'] = daily_counts.groupby('hotel_id')['n'].transform(z_mad)\n",
        "burst_days = daily_counts.loc[daily_counts['zmad'].abs() >= 3, ['hotel_id','day']].copy()\n",
        "burst_days['day'] = pd.to_datetime(burst_days['day'])\n",
        "\n",
        "# -------------- Marcar reseñas sospechosas (union de flags) --------------\n",
        "rev['day'] = rev['date'].dt.normalize()  # medianoche -> comparable con 'day'\n",
        "rev['flag_user_constant'] = rev['user_id'].isin(susp_users)\n",
        "\n",
        "rev = rev.merge(susp_user_day.assign(flag_user_many_same_day=True),\n",
        "                left_on=['user_id','day'], right_on=['user_id','day'], how='left')\n",
        "rev['flag_user_many_same_day'] = rev['flag_user_many_same_day'].fillna(False)\n",
        "\n",
        "rev = rev.merge(burst_days.assign(flag_hotel_burst=True),\n",
        "                left_on=['hotel_id','day'], right_on=['hotel_id','day'], how='left')\n",
        "rev['flag_hotel_burst'] = rev['flag_hotel_burst'].fillna(False)\n",
        "\n",
        "rev['is_suspicious'] = rev[['flag_user_constant','flag_user_many_same_day','flag_hotel_burst']].any(axis=1)\n",
        "\n",
        "# -------------- Resumen de flags --------------\n",
        "total = len(rev)\n",
        "n_susp = int(rev['is_suspicious'].sum())\n",
        "print(f\"Reseñas totales: {total} | Sospechosas: {n_susp} ({n_susp/total:.1%})\")\n",
        "print(\"Detalle flags (conteo únicos):\")\n",
        "print({\n",
        "    'users_const': int(flag_user_hi.sum()+flag_user_lo.sum()),\n",
        "    'user_many_same_day_pairs': int(len(susp_user_day)),\n",
        "    'hotel_burst_days': int(len(burst_days))\n",
        "})\n"
      ],
