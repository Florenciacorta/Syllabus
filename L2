    {
      "cell_type": "code",
      "source": [
        "# === F1 — Preparar panel hotel×tipo de viajero y mezclas (actual y global) ===\n",
        "# Deja listas las tablas para simular escenarios en F2/F3.\n",
        "import re, numpy as np, pandas as pd\n",
        "\n",
        "def first_col(df: pd.DataFrame, pats: list[str]) -> str | None:\n",
        "    \"\"\"Devuelve la primera columna cuyo nombre matchea alguno de los patrones regex.\"\"\"\n",
        "    cols = list(df.columns)\n",
        "    low  = [c.lower() for c in cols]\n",
        "    for pat in pats:\n",
        "        rx = re.compile(pat)\n",
        "        for c, lc in zip(cols, low):\n",
        "            if rx.search(lc):\n",
        "                return c\n",
        "    return None\n",
        "\n",
        "# --- Detectar columnas clave ---\n",
        "type_pats = [r'travell?er[_\\s-]?type', r'trip[_\\s-]?type', r'travel[_\\s-]?(group|category|kind)', r'party[_\\s-]?type']\n",
        "col_type_users   = first_col(df_users,  type_pats)\n",
        "col_type_reviews = first_col(df_reviews, type_pats)\n",
        "col_type = col_type_users or col_type_reviews\n",
        "assert col_type is not None, \"No pude detectar la columna de tipo de viajero (users/reviews).\"\n",
        "\n",
        "uid_users    = first_col(df_users,   [r'^user[_\\s-]?id$'])\n",
        "uid_reviews  = first_col(df_reviews, [r'^user[_\\s-]?id$'])\n",
        "hid_reviews  = first_col(df_reviews, [r'^hotel[_\\s-]?id$'])\n",
        "assert uid_reviews and hid_reviews, \"Necesito columnas user_id y hotel_id en reviews.\"\n",
        "\n",
        "# --- Base a nivel reseña con tipo de viajero ---\n",
        "if col_type_users:\n",
        "    base = (df_reviews[[uid_reviews, hid_reviews, 'score_overall']]\n",
        "            .merge(df_users[[uid_users, col_type]],\n",
        "                   left_on=uid_reviews, right_on=uid_users, how='left'))\n",
        "else:\n",
        "    base = df_reviews[[uid_reviews, hid_reviews, 'score_overall', col_type]].copy()\n",
        "\n",
        "base = base.rename(columns={hid_reviews:'hotel_id', uid_reviews:'user_id', col_type:'trav_type'})\n",
        "base['trav_type'] = (base['trav_type'].astype(str).str.strip().str.lower().replace({'nan': np.nan}))\n",
        "base = base.loc[base['score_overall'].notna() & base['trav_type'].notna()].copy()\n",
        "\n",
        "# --- Estadísticas por hotel×tipo ---\n",
        "grp_ht = (base.groupby(['hotel_id','trav_type'], as_index=False)\n",
        "               .agg(n=('score_overall','size'),\n",
        "                    mean=('score_overall','mean')))\n",
        "\n",
        "# --- Media global por tipo (para reportes/simulaciones) ---\n",
        "mean_by_type = (base.groupby('trav_type', as_index=False)\n",
        "                    .agg(mean=('score_overall','mean')))\n",
        "\n",
        "# --- Mezcla actual por hotel: proporciones de tipos (parche sin reset_index para evitar colisión) ---\n",
        "g = (base.groupby(['hotel_id','trav_type'], as_index=False)\n",
        "          .size()\n",
        "          .rename(columns={'size':'cnt'}))\n",
        "mix_curr = (g.assign(w_curr = g['cnt'] / g.groupby('hotel_id')['cnt'].transform('sum'))\n",
        "              [['hotel_id','trav_type','w_curr']])\n",
        "\n",
        "# --- Mezcla global de la plataforma ---\n",
        "mix_global = (base['trav_type'].value_counts(normalize=True)\n",
        "                    .rename_axis('trav_type')\n",
        "                    .reset_index(name='w_glob'))\n",
        "\n",
        "# --- Panel final: hotel×tipo con métricas y mezclas ---\n",
        "panel = (grp_ht\n",
        "         .merge(mix_curr,    on=['hotel_id','trav_type'], how='left')\n",
        "         .merge(mix_global,  on='trav_type',              how='left')\n",
        "         .merge(mean_by_type,on='trav_type',              how='left')\n",
        "         .rename(columns={'mean':'score_mean_type'}))\n",
        "\n",
        "# --- Resumen rápido ---\n",
        "cats = sorted(panel['trav_type'].dropna().unique().tolist())\n",
        "print(f\"Columna tipo detectada: {col_type} (preferencia users: {bool(col_type_users)})\")\n",
        "print(f\"Tipos detectados ({len(cats)}):\", cats)\n",
        "print(\"Ejemplo panel hotel×tipo:\")\n",
        "display(panel.head())\n"
      ],
