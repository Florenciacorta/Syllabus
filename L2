        "import matplotlib.pyplot as plt\n",
        "\n",
        "mplot = monthly.reset_index().rename(columns={'ym':'mes'})\n",
        "x = np.arange(len(mplot))\n",
        "\n",
        "plt.figure(figsize=(11,6))\n",
        "\n",
        "# --- Arriba: media mensual con IC95% y media móvil ---\n",
        "ax1 = plt.subplot(2,1,1)\n",
        "ax1.plot(x, mplot['mean'], marker='o', label='Media mensual')\n",
        "ax1.fill_between(x, mplot['mean']-mplot['ci95'], mplot['mean']+mplot['ci95'], alpha=0.2, label='IC95%')\n",
        "ax1.plot(x, mplot['roll3'], linewidth=2, label='Media móvil (3M)')\n",
        "\n",
        "# anotar atípicos\n",
        "out_idx = mplot.index[mplot['is_outlier']]\n",
        "for i in out_idx:\n",
        "    ax1.plot(i, mplot.loc[i,'mean'], marker='x', markersize=9)\n",
        "    ax1.text(i, mplot.loc[i,'mean'], mplot.loc[i,'mes'], rotation=90, va='bottom', fontsize=8)\n",
        "\n",
        "ax1.set_title(\"Evolución del puntaje global por mes\")\n",
        "ax1.set_ylabel(\"Media score_overall\")\n",
        "ax1.set_xticks(x[::max(1, len(x)//12)])\n",
        "ax1.set_xticklabels(mplot['mes'][::max(1, len(x)//12)], rotation=45, ha='right')\n",
        "ax1.legend()\n",
        "ax1.grid(True, alpha=0.2)\n",
        "\n",
        "# --- Abajo: % altas y % bajas ---\n",
        "ax2 = plt.subplot(2,1,2)\n",
        "ax2.plot(x, mplot['p_high'], marker='o', label='% altas (≥9)')\n",
        "ax2.plot(x, mplot['p_low'],  marker='o', label='% bajas (≤3)')\n",
        "ax2.set_title(\"Extremos por mes\")\n",
        "ax2.set_ylabel(\"Proporción\")\n",
        "ax2.set_xticks(x[::max(1, len(x)//12)])\n",
        "ax2.set_xticklabels(mplot['mes'][::max(1, len(x)//12)], rotation=45, ha='right')\n",
        "ax2.legend()\n",
        "ax2.grid(True, alpha=0.2)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n"
