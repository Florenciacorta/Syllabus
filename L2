        "# === F2 — Efecto del tipo de viajero y escenario alternativo de mezcla ===\n",
        "# Construye el ranking observado y el \"contrafactual\" usando la mezcla global de la plataforma.\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import re\n",
        "\n",
        "# (Re)definir helper por si no quedó en memoria\n",
        "def first_col(df: pd.DataFrame, pats: list[str]) -> str | None:\n",
        "    cols = list(df.columns); low = [c.lower() for c in cols]\n",
        "    for pat in pats:\n",
        "        rx = re.compile(pat)\n",
        "        for c, lc in zip(cols, low):\n",
        "            if rx.search(lc):\n",
        "                return c\n",
        "    return None\n",
        "\n",
        "# --- Columnas clave y base a nivel reseña (reutiliza lo que hicimos en F1) ---\n",
        "type_pats = [r'travell?er[_\\s-]?type', r'trip[_\\s-]?type', r'travel[_\\s-]?(group|category|kind)', r'party[_\\s-]?type']\n",
        "col_type_users   = first_col(df_users,  type_pats)\n",
        "col_type_reviews = first_col(df_reviews, type_pats)\n",
        "col_type = col_type_users or col_type_reviews\n",
        "assert col_type is not None, \"No pude detectar la columna de tipo de viajero.\"\n",
        "\n",
        "uid_reviews = first_col(df_reviews, [r'^user[_\\s-]?id$'])\n",
        "hid_reviews = first_col(df_reviews, [r'^hotel[_\\s-]?id$'])\n",
        "assert uid_reviews and hid_reviews, \"Faltan user_id/hotel_id en reviews.\"\n",
        "\n",
        "if col_type_users:\n",
        "    uid_users = first_col(df_users, [r'^user[_\\s-]?id$'])\n",
        "    base = (df_reviews[[uid_reviews, hid_reviews, 'score_overall']]\n",
        "            .merge(df_users[[uid_users, col_type]], left_on=uid_reviews, right_on=uid_users, how='left'))\n",
        "else:\n",
        "    base = df_reviews[[uid_reviews, hid_reviews, 'score_overall', col_type]].copy()\n",
        "\n",
        "base = base.rename(columns={hid_reviews:'hotel_id', uid_reviews:'user_id', col_type:'trav_type'})\n",
        "base['trav_type'] = (base['trav_type'].astype(str).str.strip().str.lower().replace({'nan': np.nan}))\n",
        "base = base.loc[base['score_overall'].notna() & base['trav_type'].notna()].copy()\n",
        "\n",
        "# --- Parámetros de robustez ---\n",
        "MIN_N_TYPE = 15       # mínimo de reseñas por hotel×tipo para usar su media propia\n",
        "MIN_TYPES  = 2        # mínimo de tipos representados en un hotel\n",
        "\n",
        "# --- Estadística por hotel×tipo ---\n",
        "ht_type = (base.groupby(['hotel_id','trav_type'], as_index=False)\n",
        "                .agg(n=('score_overall','size'),\n",
        "                     mean_ht=('score_overall','mean')))\n",
        "\n",
        "# Mezcla actual por hotel\n",
        "ht_type['w_curr'] = ht_type['n'] / ht_type.groupby('hotel_id')['n'].transform('sum')\n",
        "\n",
        "# Mezcla \"plataforma\" (global)\n",
        "mix_global = (base['trav_type'].value_counts(normalize=True)\n",
        "                    .rename_axis('trav_type').reset_index(name='w_plat'))\n",
        "\n",
        "# Media global por tipo (fallback para tipos poco representados en un hotel)\n",
        "mu_type = (base.groupby('trav_type', as_index=False)\n",
        "                .agg(mean_type=('score_overall','mean')))\n",
        "\n",
        "# Completar tabla con w_plat y mean_type\n",
        "ht_type = (ht_type\n",
        "           .merge(mix_global, on='trav_type', how='left')\n",
        "           .merge(mu_type,   on='trav_type', how='left'))\n",
        "\n",
        "# Media a usar por hotel×tipo: propia si n≥MIN_N_TYPE, si no la global del tipo\n",
        "ht_type['mean_used'] = np.where(ht_type['n'] >= MIN_N_TYPE, ht_type['mean_ht'], ht_type['mean_type'])\n",
        "\n",
        "# --- Observado por hotel (media real) y #reseñas totales ---\n",
        "mean_hotel_obs = (base.groupby('hotel_id', as_index=False)\n",
        "                       .agg(obs=('score_overall','mean'),\n",
        "                            n_total=('score_overall','size')))\n",
        "\n",
        "# #tipos representados por hotel (para filtrar elegibles)\n",
        "k_types = (ht_type.assign(flag=(ht_type['n'] >= MIN_N_TYPE))\n",
        "                 .groupby('hotel_id')['flag'].sum().reset_index(name='k_types'))\n",
        "\n",
        "# --- Predicción contrafactual con mezcla plataforma ---\n",
        "pred_plat = (ht_type\n",
        "             .assign(prod=lambda d: d['w_plat'] * d['mean_used'])\n",
        "             .groupby('hotel_id', as_index=False)['prod'].sum()\n",
        "             .rename(columns={'prod':'plat'}))\n",
        "\n",
        "# (Opcional) Predicción con mezcla observada reconstruida (debería ≈ obs)\n",
        "pred_curr = (ht_type\n",
        "             .assign(prod=lambda d: d['w_curr'] * d['mean_used'])\n",
        "             .groupby('hotel_id', as_index=False)['prod'].sum()\n",
        "             .rename(columns={'prod':'obs_recon'}))\n",
        "\n",
        "# --- Armar tabla final por hotel y ranking/shift ---\n",
        "hot = (mean_hotel_obs\n",
        "       .merge(pred_plat, on='hotel_id', how='left')\n",
        "       .merge(pred_curr, on='hotel_id', how='left')\n",
        "       .merge(k_types,    on='hotel_id', how='left'))\n",
        "\n",
        "# Nombre del hotel si existe\n",
        "name_col = first_col(df_hotels, [r'hotel[_\\s-]?name', r'\\bname\\b', r'title'])\n",
        "if name_col and name_col in df_hotels.columns:\n",
        "    hot = hot.merge(df_hotels[['hotel_id', name_col]], on='hotel_id', how='left')\n",
        "    hot = hot.rename(columns={name_col:'hotel_name'})\n",
        "else:\n",
        "    hot['hotel_name'] = hot['hotel_id'].astype(str)\n",
        "\n",
        "# Elegibles para comparar (al menos MIN_TYPES con n≥MIN_N_TYPE)\n",
        "eligible = hot.loc[hot['k_types'].fillna(0) >= MIN_TYPES, 'hotel_id']\n",
        "hot = hot.loc[hot['hotel_id'].isin(eligible)].copy()\n",
        "\n",
        "# Rankings y desplazamientos\n",
        "hot['rank_obs']  = hot['obs'].rank(ascending=False, method='min')\n",
        "hot['rank_plat'] = hot['plat'].rank(ascending=False, method='min')\n",
        "hot['shift_plat'] = hot['rank_plat'] - hot['rank_obs']   # positivo: bajaría en el ranking\n",
        "\n",
        "# --- Salidas principales ---\n",
        "print(f\"Hoteles elegibles: {hot.shape[0]}  |  Tipos detectados: {base['trav_type'].nunique()}\")\n",
        "print(\"Mezcla plataforma (primeros 10):\")\n",
        "display(mix_global.head(10))\n",
        "print(\"Resumen por hotel (obs vs. contrafactual plataforma):\")\n",
        "display(hot[['hotel_id','hotel_name','n_total','obs','plat','obs_recon','rank_obs','rank_plat','shift_plat']].sort_values('rank_obs').head(10))\n",
        "\n",
        "# --- Gráficos rápidos ---\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "plt.figure(figsize=(6,6))\n",
        "plt.scatter(hot['obs'], hot['plat'], alpha=0.8)\n",
        "lims = [min(hot[['obs','plat']].min())-0.02, max(hot[['obs','plat']].max())+0.02]\n",
        "plt.plot(lims, lims, linestyle='--')\n",
        "plt.xlim(lims); plt.ylim(lims)\n",
        "plt.xlabel('Puntaje observado (media hotel)'); plt.ylabel('Puntaje contrafactual (mix plataforma)')\n",
        "plt.title('Puntaje actual vs. contrafactual (mix plataforma)')\n",
        "plt.tight_layout(); plt.show()\n",
        "\n",
        "# Barras de mayores desplazamientos absolutos\n",
        "abs_shift = hot.assign(abs_shift=np.abs(hot['shift_plat'])).sort_values('abs_shift', ascending=False).head(12)\n",
        "plt.figure(figsize=(8,5))\n",
        "plt.barh(abs_shift['hotel_name'], abs_shift['shift_plat'])\n",
        "plt.axvline(0, linestyle='--')\n",
        "plt.gca().invert_yaxis()\n",
        "plt.xlabel('Desplazamiento de ranking (obs – plataforma)')\n",
        "plt.title('Mayores cambios de ranking bajo mix plataforma')\n",
        "plt.tight_layout(); plt.show()\n"
      ],
