        "import pandas as pd, io, re\n",
        "from google.colab import files\n",
        "\n",
        "# 1) Subir archivos (puedes hacerlo en varias tandas)\n",
        "subidos = {}\n",
        "print(\"Sube hotels.csv, users.csv y reviews.csv (puedes hacerlo en 1 o varias tandas).\")\n",
        "while True:\n",
        "    nuevos = files.upload()      # abre diálogo\n",
        "    subidos.update(nuevos)       # acumula\n",
        "    print(\"Archivos acumulados:\", list(subidos.keys()))\n",
        "    # si ya están los 3, o si no vas a subir más, rompe con Ctrl+C o continua una vez más\n",
        "    if len(subidos) >= 3:\n",
        "        break\n",
        "\n",
        "# 2) Helper: encontrar archivo aunque tenga '(1)' u otras variantes\n",
        "def _encontrar(base, dic):\n",
        "    # acepta \"hotels.csv\", \"hotels (1).csv\", \"HOTELS.csv\", etc.\n",
        "    patron = re.compile(rf'^{re.escape(base)}(\\s*\\(\\d+\\))?\\.csv$', re.I)\n",
        "    for k in dic.keys():\n",
        "        if patron.match(k):\n",
        "            return k\n",
        "    raise FileNotFoundError(f\"No encuentro {base}.csv en: {list(dic)}\")\n",
        "\n",
        "def _leer(base):\n",
        "    key = _encontrar(base, subidos)\n",
        "    return pd.read_csv(io.BytesIO(subidos[key]), low_memory=False)\n",
        "\n",
        "# 3) Cargar DataFrames\n",
        "df_hotels  = _leer(\"hotels\")\n",
        "df_users   = _leer(\"users\")\n",
        "df_reviews = _leer(\"reviews\")\n",
        "\n",
        "# 4) Chequeos rápidos\n",
        "for nombre, df in {\"hotels\":df_hotels, \"users\":df_users, \"reviews\":df_reviews}.items():\n",
        "    print(f\"\\n=== {nombre} === shape={df.shape}\")\n",
        "    display(df.head(3))\n",
        "    display(df.dtypes.to_frame(\"dtype\").T)\n",
        "\n",
        "# 5) Test mínimo de columnas clave (ajusta si tus nombres reales difieren)\n",
        "posibles = {\n",
        "    \"hotels\":  {\"hotel_id\"},\n",
        "    \"users\":   {\"user_id\"},\n",
        "    \"reviews\": {\"review_id\", \"hotel_id\", \"user_id\"},\n",
        "}\n",
        "for nombre, req in posibles.items():\n",
        "    df = {\"hotels\": df_hotels, \"users\": df_users, \"reviews\": df_reviews}[nombre]\n",
        "    faltan = req - set(df.columns)\n",
        "    msg_ok = f\"✅ {nombre}: columnas clave presentes: {sorted(req)}\"\n",
        "    msg_bad = f\"⚠️ OJO: En {nombre} faltan columnas esperadas: {faltan}\"\n",
        "    print(msg_ok if not faltan else msg_bad)\n"
