        "x = np.arange(2)\n",
        "plt.bar(x - w/2, [p_high_loc, p_high_vis], width=w, label='% altas (≥9)')\n",
        "plt.bar(x + w/2, [p_low_loc,  p_low_vis],  width=w, label='% bajas (≤3)')\n",
        "plt.xticks(x, ['Local', 'Visitante'])\n",
        "plt.ylabel('Proporción')\n",
        "plt.title('Reseñas extremas por grupo')\n",
        "plt.legend()\n",
        "plt.tight_layout(); plt.show()\n"
