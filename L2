        "## e) “Valor por dinero” ajustado por calidad y atributos\n",
        "\n",
        "**Objetivo.** Detectar hoteles “sobrevalorados” (reciben *más* puntaje de **value for money** que lo esperable) o “subvalorados” (reciben *menos*), **controlando** por otras dimensiones de calidad y, si existen, atributos del hotel.\n",
        "\n",
        "**Idea.**  \n",
        "1) Para cada hotel calculamos la **media** del sub-puntaje `value for money` y de los demás sub-puntajes (limpieza, confort, etc.).  \n",
        "2) Sumamos **atributos** numéricos del `df_hotels` (p. ej., estrellas), si están disponibles.  \n",
        "3) Ajustamos un modelo lineal:  \n",
        "   \\[\n",
        "   \\overline{\\text{value}} \\sim \\text{(otros sub-scores)} + \\text{(atributos)}\n",
        "   \\]\n",
        "   Estandarizamos predictores para comparabilidad.  \n",
        "4) Marcamos **residuales** (observado − predicho). Con un z-score robusto (MAD) definimos outliers: \\(|z_{\\text{res}}|\\ge 2\\).  \n",
        "5) Reportamos tablas de hoteles **sobrevalorados** (resid>0) y **subvalorados** (resid<0), y gráficos de soporte.\n"
      ],
      "metadata": {
        "id": "Y6aurQ6AOVM0"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# 🧪 Celda de código (E1) — Base por hotel, ajuste y ranking “sobre/subvalorado”\n",
        "\n",
        "import re, numpy as np, pandas as pd\n",
        "from numpy.linalg import lstsq\n",
        "\n",
        "# ---------- 0) Helpers ----------\n",
        "def first_col(df, pats):\n",
        "    cols = list(df.columns)\n",
        "    low  = [c.lower() for c in cols]\n",
        "    for pat in pats:\n",
        "        rx = re.compile(pat, re.I)\n",
        "        for c, cl in zip(cols, low):\n",
        "            if rx.search(cl):\n",
        "                return c\n",
        "    return None\n",
        "\n",
        "def detect_value_col(df_reviews):\n",
        "    # busco una columna de \"valor por dinero\"\n",
        "    patterns = [\n",
        "        r\"^score_value_for_money$\",\n",
        "        r\"value[_ ]?for[_ ]?money\",\n",
        "        r\"\\bvalue\\b.*money|\\bmoney\\b.*value\",\n",
        "        r\"(bang|valor).*(buck|dinero)\"\n",
        "    ]\n",
        "    for p in patterns:\n",
        "        c = first_col(df_reviews, [p])\n",
        "        if c: return c\n",
        "    return None\n",
        "\n",
        "# ---------- 1) Detectar columnas útiles ----------\n",
        "value_col = detect_value_col(df_reviews)\n",
        "assert value_col is not None, \"No encontré columna de 'value for money' en df_reviews.\"\n",
        "\n",
        "# sub-scores candidatos = columnas que empiezan por 'score_' excluyendo overall y value\n",
        "score_cols = [c for c in df_reviews.columns\n",
        "              if c.lower().startswith(\"score_\")]\n",
        "score_cols = [c for c in score_cols if c != value_col and c.lower() != \"score_overall\"]\n",
        "\n",
        "# Por si acaso, filtro a numéricos y con algo de varianza\n",
        "score_cols = [c for c in score_cols\n",
        "              if pd.api.types.is_numeric_dtype(df_reviews[c]) and df_reviews[c].nunique(dropna=True) > 1]\n",
        "\n",
        "assert len(score_cols) >= 1, \"No hay sub-scores (aparte de value/overall) para usar como predictores.\"\n",
        "\n",
        "# Atributos numéricos del hotel (opcionales)\n",
        "num_hot = [c for c in df_hotels.columns\n",
        "           if pd.api.types.is_numeric_dtype(df_hotels[c])\n",
        "           and df_hotels[c].nunique(dropna=True) > 1]\n",
        "\n",
        "# descarto lat/lon y los ids\n",
        "drop_like = {\"lat\",\"latitude\",\"lon\",\"lng\",\"longitude\",\"hotel_id\",\"user_id\",\"review_id\"}\n",
        "attr_cols = [c for c in num_hot if c.lower() not in drop_like]\n",
        "\n",
        "# nombre del hotel (si existe)\n",
        "name_col = first_col(df_hotels, [r\"hotel[_ ]?name\", r\"\\bname\\b\", r\"title\"])\n",
        "if name_col is None:\n",
        "    name_col = \"hotel_id\"\n",
        "\n",
        "# ---------- 2) Agregación a nivel hotel ----------\n",
        "group_cols = [value_col] + score_cols\n",
        "gb = (df_reviews\n",
        "      .groupby(\"hotel_id\")[group_cols]\n",
        "      .mean()\n",
        "      .rename(columns={value_col: \"value_mean\"}))\n",
        "\n",
        "gb[\"n\"] = df_reviews.groupby(\"hotel_id\")[value_col].size()\n",
        "\n",
        "# Atributos del hotel (merge opcional)\n",
        "attrs_to_use = attr_cols.copy()\n",
        "hot_attrs = df_hotels[[\"hotel_id\", name_col] + attrs_to_use].copy()\n",
        "\n",
        "base = gb.reset_index().merge(hot_attrs, on=\"hotel_id\", how=\"left\")\n",
        "\n",
        "# Eliminar hoteles sin valor_mean o con NA en todos los predictores\n",
        "X_cols = score_cols + attrs_to_use\n",
        "# quito predictores con desviación estándar 0 (constantes)\n",
        "keep = []\n",
        "for c in X_cols:\n",
        "    if c in base and pd.api.types.is_numeric_dtype(base[c]) and base[c].std(ddof=0) > 0:\n",
        "        keep.append(c)\n",
        "X_cols = keep\n",
        "\n",
        "assert len(X_cols) >= 1, \"No quedaron predictores útiles (todos constantes o no numéricos).\"\n",
        "\n",
        "base = base.dropna(subset=[\"value_mean\"])\n",
        "\n",
        "# Completo faltantes de predictores con su media (a nivel hotel) para no perder hoteles\n",
        "for c in X_cols:\n",
        "    if base[c].isna().any():\n",
        "        base[c] = base[c].fillna(base[c].mean())\n",
        "\n",
        "# ---------- 3) Estandarización de predictores y OLS ----------\n",
        "Z = base[X_cols].astype(float).copy()\n",
        "Z = (Z - Z.mean()) / Z.std(ddof=0)   # z-score\n",
        "Z = Z.replace([np.inf,-np.inf], np.nan).fillna(0.0)\n",
        "\n",
        "X = np.c_[np.ones(len(Z)), Z.values]  # intercepto + predictores\n",
        "y = base[\"value_mean\"].values\n",
        "\n",
        "beta = lstsq(X, y, rcond=None)[0]\n",
        "pred = X @ beta\n",
        "\n",
        "# ---------- 4) Residuales + z-score robusto ----------\n",
        "resid = y - pred\n",
        "med  = np.median(resid)\n",
        "mad  = np.median(np.abs(resid - med))\n",
        "robust_sigma = 1.4826 * mad if mad > 0 else resid.std(ddof=0) if resid.std(ddof=0) > 0 else 1.0\n",
        "z_res = (resid - med) / robust_sigma\n",
        "\n",
        "out_hi = z_res >= 2.0   # sobrevalorados\n",
        "out_lo = z_res <= -2.0  # subvalorados\n",
        "\n",
        "res = base[[\"hotel_id\", name_col, \"n\", \"value_mean\"]].copy()\n",
        "res[\"pred\"]   = pred\n",
        "res[\"resid\"]  = resid\n",
        "res[\"z_res\"]  = z_res\n",
        "res = res.rename(columns={name_col: \"hotel_name\"})\n",
        "res = res.sort_values(\"resid\", ascending=False).reset_index(drop=True)\n",
        "\n",
        "# Ranks (por curiosidad)\n",
        "res[\"rank_raw\"] = res[\"value_mean\"].rank(ascending=False, method=\"min\")\n",
        "res[\"rank_pred\"] = res[\"pred\"].rank(ascending=False, method=\"min\")\n",
        "res[\"rank_shift\"] = res[\"rank_raw\"] - res[\"rank_pred\"]\n",
        "\n",
        "print(\"=== Ajuste 'value for money' ~ otros sub-scores (+ atributos) ===\")\n",
        "print(f\"Hoteles válidos: {len(res)}\")\n",
        "print(\"Predictores usados:\", X_cols)\n",
        "print(\"\\nCoeficientes (estandarizados):\")\n",
        "coefs = pd.Series(beta[1:], index=X_cols)\n",
        "display(coefs.to_frame(\"beta\"))\n",
        "\n",
        "print(\"\\n=== Sobrevalorados (z_res ≥ 2) ===\")\n",
        "display(res.loc[out_hi, [\"hotel_id\",\"hotel_name\",\"n\",\"value_mean\",\"pred\",\"resid\",\"z_res\",\"rank_shift\"]]\n",
        "        .sort_values(\"z_res\", ascending=False).head(10))\n",
        "\n",
        "print(\"\\n=== Subvalorados (z_res ≤ -2) ===\")\n",
        "display(res.loc[out_lo, [\"hotel_id\",\"hotel_name\",\"n\",\"value_mean\",\"pred\",\"resid\",\"z_res\",\"rank_shift\"]]\n",
        "        .sort_values(\"z_res\", ascending=True).head(10))\n",
        "\n",
        "print(\"\\n=== Top 10 residuales (±) ===\")\n",
        "top_up   = res.nlargest(10, \"resid\")[[\"hotel_id\",\"hotel_name\",\"n\",\"value_mean\",\"pred\",\"resid\",\"z_res\",\"rank_shift\"]]\n",
        "top_down = res.nsmallest(10, \"resid\")[[\"hotel_id\",\"hotel_name\",\"n\",\"value_mean\",\"pred\",\"resid\",\"z_res\",\"rank_shift\"]]\n",
        "display(top_up); display(top_down)\n",
        "\n",
        "# Guardamos para graficar\n",
        "res_vfm = res.copy()\n"
      ],
