        "# ====== Imports ======\n",
        "import re, unicodedata\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# ====== Helpers ======\n",
        "def _strip_accents(s):\n",
        "    s = str(s)\n",
        "    import unicodedata as _ud\n",
        "    s = _ud.normalize(\"NFKD\", s)\n",
        "    return \"\".join(ch for ch in s if not _ud.combining(ch))\n",
        "\n",
        "def canon_country(x):\n",
        "    if pd.isna(x):\n",
        "        return np.nan\n",
        "    s = _strip_accents(str(x)).strip().lower()\n",
        "    if not s:\n",
        "        return np.nan\n",
        "    s = re.sub(r\"[^a-z0-9\\s\\-\\.]\", \" \", s)\n",
        "    s = re.sub(r\"\\s+\", \" \", s).strip()\n",
        "    if re.fullmatch(r\"[a-z]{2}\", s):\n",
        "        return s\n",
        "    m = {\n",
        "        \"united states\":\"us\",\"usa\":\"us\",\"u.s.\":\"us\",\"eeuu\":\"us\",\"us\":\"us\",\n",
        "        \"united kingdom\":\"gb\",\"great britain\":\"gb\",\"uk\":\"gb\",\"england\":\"gb\",\"scotland\":\"gb\",\n",
        "        \"south korea\":\"kr\",\"korea republic of\":\"kr\",\"korea\":\"kr\",\n",
        "        \"russia\":\"ru\",\"rusia\":\"ru\",\n",
        "        \"spain\":\"es\",\"espana\":\"es\",\n",
        "        \"chile\":\"cl\",\"peru\":\"pe\",\"argentina\":\"ar\",\"mexico\":\"mx\",\"brazil\":\"br\",\"brasil\":\"br\",\n",
        "        \"italy\":\"it\",\"italia\":\"it\",\"france\":\"fr\",\"francia\":\"fr\",\"germany\":\"de\",\"alemania\":\"de\",\n",
        "        \"portugal\":\"pt\",\"canada\":\"ca\",\"australia\":\"au\",\"new zealand\":\"nz\",\n",
        "        \"japan\":\"jp\",\"china\":\"cn\",\"turkey\":\"tr\",\"turquia\":\"tr\",\n",
        "        \"united arab emirates\":\"ae\",\"uae\":\"ae\"\n",
        "    }\n",
        "    if s in m:\n",
        "        return m[s]\n",
        "    for k, v in m.items():\n",
        "        if k in s:\n",
        "            return v\n",
        "    return s\n",
        "\n",
        "def first_matching_col(df, patterns):\n",
        "    cols = list(df.columns)\n",
        "    cols_l = [c.lower() for c in cols]\n",
        "    for pat in patterns:\n",
        "        rx = re.compile(pat)\n",
        "        for c, cl in zip(cols, cols_l):\n",
        "            if rx.search(cl):\n",
        "                return c\n",
        "    return None\n",
        "\n",
        "# ====== 1) Detectar columnas de país ======\n",
        "pat_users = [\n",
        "    r\"^(residence[_ ]?country|country_of_residence)$\",\n",
        "    r\"(home|residen).*?(country|pais)\",\n",
        "    r\"nationalit\",                    # \"nationality\"\n",
        "    r\"^country$\", r\"pais\", r\"user_?country\"\n",
        "]\n",
        "pat_hotels = [\n",
        "    r\"^(country|pais)$\", r\"(hotel_)?country(_name|_code)?\", r\"(pais|country)\"\n",
        "]\n",
        "\n",
        "user_country_col  = first_matching_col(df_users,  pat_users)\n",
        "hotel_country_col = first_matching_col(df_hotels, pat_hotels)\n",
        "\n",
        "print(\"Columna país (users):\", user_country_col)\n",
        "print(\"Columna país (hotels):\", hotel_country_col)\n",
        "\n",
        "assert user_country_col is not None, \"No pude detectar una columna de país en df_users.\"\n",
        "assert hotel_country_col is not None, \"No pude detectar una columna de país en df_hotels.\"\n",
        "\n",
        "# ====== 2) Pre-rename y merges (evita country_x / country_y) ======\n",
        "u = df_users[['user_id', user_country_col]].copy()\n",
        "h = df_hotels[['hotel_id', hotel_country_col]].copy()\n",
        "u = u.rename(columns={user_country_col: 'user_country_raw'})\n",
        "h = h.rename(columns={hotel_country_col:'hotel_country_raw'})\n",
        "\n",
        "tmp = (df_reviews[['user_id','hotel_id','score_overall']]\n",
        "       .merge(u, on='user_id', how='left')\n",
        "       .merge(h, on='hotel_id', how='left'))\n",
        "\n",
        "# Chequeos defensivos\n",
        "assert 'user_country_raw'  in tmp.columns, f\"Falta columna user_country_raw. Columnas: {tmp.columns.tolist()}\"\n",
        "assert 'hotel_country_raw' in tmp.columns, f\"Falta columna hotel_country_raw. Columnas: {tmp.columns.tolist()}\"\n",
        "\n",
        "# ====== 3) Normalizar países y construir is_local ======\n",
        "tmp['user_country_c']  = tmp['user_country_raw'].map(canon_country)\n",
        "tmp['hotel_country_c'] = tmp['hotel_country_raw'].map(canon_country)\n",
        "\n",
        "base = tmp.loc[\n",
        "    tmp['score_overall'].notna()\n",
        "    & tmp['user_country_c'].notna()\n",
        "    & tmp['hotel_country_c'].notna()\n",
        "].copy()\n",
        "\n",
        "base['is_local'] = (base['user_country_c'] == base['hotel_country_c'])\n",
        "\n",
        "n_local = int(base['is_local'].sum())\n",
        "n_visit = int((~base['is_local']).sum())\n",
        "print(f\"n_local={n_local} | n_visit={n_visit}\")\n",
        "assert n_local > 0 and n_visit > 0, \"No hay ambos grupos (local/visitante) con puntaje global válido.\"\n",
        "\n",
        "# ====== 4) Resumen por grupo ======\n",
        "grp = base.groupby('is_local')['score_overall']\n",
        "res = grp.agg(n='count', mean='mean', sd='std', median='median').reset_index()\n",
        "res['grupo'] = np.where(res['is_local'], 'Local (pais coincide)', 'Visitante')\n",
        "res = res[['grupo','n','mean','sd','median']]\n",
        "\n",
        "# Diferencias y tamaño de efecto\n",
        "m_loc, s_loc, n1 = res.loc[res['grupo']=='Local (pais coincide)', ['mean','sd','n']].values[0]\n",
        "m_vis, s_vis, n2 = res.loc[res['grupo']=='Visitante', ['mean','sd','n']].values[0]\n",
        "delta = float(m_loc - m_vis)\n",
        "sp2 = ((n1-1)*(s_loc**2) + (n2-1)*(s_vis**2)) / max(n1+n2-2, 1)\n",
        "sp  = float(np.sqrt(max(sp2, 1e-12)))\n",
        "cohen_d = delta / sp\n",
        "se = np.sqrt((s_loc**2)/n1 + (s_vis**2)/n2)\n",
        "ci_low = delta - 1.96*se\n",
        "ci_high = delta + 1.96*se\n",
        "\n",
        "# Proporciones extremas\n",
        "base['is_high'] = base['score_overall'] >= 9\n",
        "base['is_low']  = base['score_overall'] <= 3\n",
        "props = base.groupby('is_local')[['is_high','is_low']].mean().reset_index()\n",
        "p_high_loc = float(props.loc[props['is_local'], 'is_high'])\n",
        "p_high_vis = float(props.loc[~props['is_local'], 'is_high'])\n",
        "p_low_loc  = float(props.loc[props['is_local'], 'is_low'])\n",
        "p_low_vis  = float(props.loc[~props['is_local'], 'is_low'])\n",
        "\n",
        "print(\"\\n=== Resumen por grupo ===\")\n",
        "display(res.style.format({'mean':'{:.3f}','sd':'{:.3f}','median':'{:.3f}'}))\n",
        "\n",
        "print(f\"Δ media (local - visitante) = {delta:.3f} \"\n",
        "      f\"| IC95% [{ci_low:.3f}, {ci_high:.3f}] \"\n",
        "      f\"| d de Cohen = {cohen_d:.3f}\")\n",
        "print(f\"% altas (≥9): local={100*p_high_loc:.1f}% vs visitante={100*p_high_vis:.1f}%\")\n",
        "print(f\"% bajas (≤3): local={100*p_low_loc:.1f}% vs visitante={100*p_low_vis:.1f}%\")\n",
        "\n",
        "# ====== 5) Gráficos ======\n",
        "# A) Medias con IC\n",
        "plt.figure(figsize=(6,4))\n",
        "means = [m_loc, m_vis]\n",
        "ses   = [s_loc/np.sqrt(n1), s_vis/np.sqrt(n2)]\n",
        "x = np.arange(2)\n",
        "plt.bar(x, means)\n",
        "for xi, m, se_i in zip(x, means, ses):\n",
        "    plt.plot([xi, xi], [m-1.96*se_i, m+1.96*se_i])\n",
        "plt.xticks(x, ['Local', 'Visitante'])\n",
        "plt.ylabel('Media score_overall')\n",
        "plt.title('Puntaje global: medias por grupo (IC95%)')\n",
        "plt.tight_layout(); plt.show()\n",
        "\n",
        "# B) % reseñas altas/bajas por grupo\n",
        "plt.figure(figsize=(7,4))\n",
