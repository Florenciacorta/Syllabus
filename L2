    {
      "cell_type": "code",
      "source": [
        "# 🧪 Celda de código (D1) — Preparar métricas de “ubicación real” y score de ubicación (FIX)\n",
        "import re\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "# ---------- helpers ----------\n",
        "def first_col(df, pats):\n",
        "    cols_l = {c: c.lower() for c in df.columns}\n",
        "    for pat in pats:\n",
        "        rx = re.compile(pat, re.I)\n",
        "        for c, cl in cols_l.items():\n",
        "            if rx.search(cl):\n",
        "                return c\n",
        "    return None\n",
        "\n",
        "def haversine_km(lat1, lon1, lat2, lon2):\n",
        "    R = 6371.0088\n",
        "    lat1, lon1, lat2, lon2 = map(np.radians, [lat1,lon1,lat2,lon2])\n",
        "    dlat = lat2-lat1\n",
        "    dlon = lon2-lon1\n",
        "    a = np.sin(dlat/2.0)**2 + np.cos(lat1)*np.cos(lat2)*np.sin(dlon/2.0)**2\n",
        "    c = 2*np.arcsin(np.sqrt(a))\n",
        "    return R*c\n",
        "\n",
        "def z_mad(x):\n",
        "    x = np.asarray(x, dtype=float)\n",
        "    med = np.nanmedian(x)\n",
        "    mad = np.nanmedian(np.abs(x - med))\n",
        "    if mad == 0:\n",
        "        sd = np.nanstd(x, ddof=0)\n",
        "        return (x - np.nanmean(x))/sd if sd>0 else np.zeros_like(x)\n",
        "    return 0.6745*(x - med)/(mad if mad!=0 else 1.0)\n",
        "\n",
        "# ---------- 1) detectar columnas ----------\n",
        "lat_col = first_col(df_hotels, [r'\\blat\\b', r'latitude'])\n",
        "lon_col = first_col(df_hotels, [r'\\blon\\b', r'\\blng\\b', r'longitude'])\n",
        "city_col = first_col(df_hotels, [r'\\bcity\\b', r'ciudad', r'localidad', r'town'])\n",
        "\n",
        "score_loc_col = first_col(df_reviews, [r'score[_ ]?location', r'location[_ ]?score', r'ubicaci[oó]n'])\n",
        "\n",
        "assert lat_col and lon_col, \"No pude detectar columnas de lat/lon en df_hotels.\"\n",
        "assert score_loc_col, \"No pude detectar la columna de score de ubicación en df_reviews.\"\n",
        "\n",
        "print(f\"Columnas lat/lon detectadas: {lat_col} / {lon_col}\")\n",
        "print(\"Columna de ciudad:\", city_col or \"(no disponible, se asume una sola ciudad)\")\n",
        "print(\"Columna score_location (reviews):\", score_loc_col)\n",
        "\n",
        "# ---------- 2) centro de ciudad y distancia por hotel ----------\n",
        "hot = df_hotels[['hotel_id', lat_col, lon_col] + ([city_col] if city_col else [])].copy()\n",
        "hot = hot.dropna(subset=[lat_col, lon_col])\n",
        "\n",
        "# ✅ FIX: si hay city, llenar NAs en la SERIE; si no hay, crear una única ciudad.\n",
        "if not city_col:\n",
        "    hot['__city__'] = 'ALL'\n",
        "    city_col_use = '__city__'\n",
        "else:\n",
        "    hot[city_col] = hot[city_col].fillna('UNK')  # <-- corregido\n",
        "    city_col_use = city_col\n",
        "\n",
        "centros = (hot\n",
        "           .groupby(city_col_use, as_index=False)\n",
        "           .agg({lat_col:'median', lon_col:'median'})\n",
        "           .rename(columns={lat_col:'lat_c', lon_col:'lon_c'}))\n",
        "\n",
        "hot2 = hot.merge(centros, on=city_col_use, how='left')\n",
        "hot2['dist_km'] = haversine_km(hot2[lat_col], hot2[lon_col], hot2['lat_c'], hot2['lon_c'])\n",
        "hot2['dist_z'] = hot2.groupby(city_col_use)['dist_km'].transform(z_mad)\n",
        "\n",
        "# ---------- 3) promedio de score_location por hotel ----------\n",
        "MIN_N = 50  # mínimo de reseñas por hotel para estabilidad\n",
        "loc_mean = (df_reviews\n",
        "            .dropna(subset=[score_loc_col, 'hotel_id'])\n",
        "            .groupby('hotel_id')[score_loc_col]\n",
        "            .agg(['mean','median','std','count'])\n",
        "            .rename(columns={'count':'n'})\n",
        "            .reset_index())\n",
        "\n",
        "base = (hot2\n",
        "        .merge(loc_mean, on='hotel_id', how='inner')\n",
        "        .rename(columns={'mean':'score_loc_mean',\n",
        "                         'median':'score_loc_median',\n",
        "                         'std':'score_loc_sd'}))\n",
        "\n",
        "base = base.loc[base['n'] >= MIN_N].copy()\n",
        "\n",
        "# Nombre del hotel (si existe)\n",
        "name_col = first_col(df_hotels, [r'hotel[_ ]?name', r'\\bname\\b', r'title'])\n",
        "if name_col and name_col in df_hotels.columns:\n",
        "    base = base.merge(df_hotels[['hotel_id', name_col]], on='hotel_id', how='left')\n",
        "    base = base.rename(columns={name_col:'hotel_name'})\n",
        "else:\n",
        "    base['hotel_name'] = base['hotel_id'].astype(str)\n",
        "\n",
        "print(f\"Hoteles válidos para análisis (n≥{MIN_N}): {len(base)}\")\n",
        "display(base.head())\n"
      ],
