        "# 🧪 Celda de código (C2) — Efecto en hoteles: medias ajustadas y cambio de ranking\n",
        "\n",
        "# Intentar detectar nombre del hotel (para tablas)\n",
        "hotel_name_col = None\n",
        "for c in [\"hotel_name\",\"name\",\"nombre\",\"title\"]:\n",
        "    if c in df_hotels.columns:\n",
        "        hotel_name_col = c\n",
        "        break\n",
        "\n",
        "# 1) Score ajustado por severidad del usuario: score_adj = score_overall - mean_res_usuario\n",
        "rev2 = rev.merge(user_stats[[\"user_id\",\"mean_res\"]], on=\"user_id\", how=\"left\")\n",
        "rev2[\"mean_res\"].fillna(0.0, inplace=True)  # usuarios con < MIN_REV no ajustan\n",
        "rev2[\"score_adj\"] = rev2[\"score_overall\"] - rev2[\"mean_res\"]\n",
        "\n",
        "# 2) Agregar por hotel: media bruta vs ajustada y delta\n",
        "hot = (rev2.groupby(\"hotel_id\", as_index=False)\n",
        "            .agg(n=(\"score_overall\",\"size\"),\n",
        "                 raw_mean=(\"score_overall\",\"mean\"),\n",
        "                 adj_mean=(\"score_adj\",\"mean\")) )\n",
        "hot[\"delta\"] = hot[\"adj_mean\"] - hot[\"raw_mean\"]  # >0: al ajustar, sube\n",
        "\n",
        "# Agregar nombre de hotel (si existe)\n",
        "if hotel_name_col:\n",
        "    hot = hot.merge(df_hotels[[\"hotel_id\", hotel_name_col]], on=\"hotel_id\", how=\"left\")\n",
        "\n",
        "# 3) Cambios de ranking\n",
        "hot[\"rank_raw\"] = hot[\"raw_mean\"].rank(method=\"min\", ascending=False)\n",
        "hot[\"rank_adj\"] = hot[\"adj_mean\"].rank(method=\"min\", ascending=False)\n",
        "hot[\"rank_shift\"] = hot[\"rank_raw\"] - hot[\"rank_adj\"]  # + = mejora ranking con ajuste\n",
        "\n",
        "print(\"=== Hoteles con mayor cambio de ranking (|rank_shift|) ===\")\n",
        "top_shift = hot.assign(abs_shift=hot[\"rank_shift\"].abs()) \\\n",
        "               .sort_values(\"abs_shift\", ascending=False) \\\n",
        "               .head(10)\n",
        "display(top_shift if hotel_name_col else top_shift[[\"hotel_id\",\"n\",\"raw_mean\",\"adj_mean\",\"delta\",\"rank_raw\",\"rank_adj\",\"rank_shift\"]])\n",
        "\n",
        "print(\"\\n=== Top 10 Δ (adj_mean - raw_mean) > 0 (suben más al ajustar) ===\")\n",
        "up = hot.sort_values(\"delta\", ascending=False).head(10)\n",
        "display(up if hotel_name_col else up[[\"hotel_id\",\"n\",\"raw_mean\",\"adj_mean\",\"delta\"]])\n",
        "\n",
        "print(\"\\n=== Top 10 Δ (adj_mean - raw_mean) < 0 (bajan más al ajustar) ===\")\n",
        "down = hot.sort_values(\"delta\", ascending=True).head(10)\n",
        "display(down if hotel_name_col else down[[\"hotel_id\",\"n\",\"raw_mean\",\"adj_mean\",\"delta\"]])\n",
        "\n",
        "# 4) Gráficos: dispersión cruda vs ajustada y distribución de deltas\n",
        "plt.figure(figsize=(5.5,5))\n",
        "plt.scatter(hot[\"raw_mean\"], hot[\"adj_mean\"], s=12, alpha=0.7)\n",
        "mn = float(min(hot[\"raw_mean\"].min(), hot[\"adj_mean\"].min()))\n",
        "mx = float(max(hot[\"raw_mean\"].max(), hot[\"adj_mean\"].max()))\n",
        "plt.plot([mn,mx],[mn,mx], linestyle=\"--\")\n",
        "plt.xlabel(\"Media bruta por hotel\")\n",
        "plt.ylabel(\"Media ajustada por severidad\")\n",
        "plt.title(\"Hotel: media bruta vs ajustada\")\n",
        "plt.tight_layout(); plt.show()\n",
        "\n",
        "plt.figure(figsize=(7,3))\n",
        "plt.hist(hot[\"delta\"], bins=40)\n",
        "plt.axvline(0, linestyle=\"--\")\n",
        "plt.title(\"Distribución de Δ = adj_mean - raw_mean (hotel)\")\n",
        "plt.xlabel(\"Δ (puntos)\"); plt.ylabel(\"hoteles\")\n",
        "plt.tight_layout(); plt.show()\n",
        "\n",
        "# 5) Resumen numérico útil para el reporte\n",
        "corr_delta_n = float(hot[[\"delta\",\"n\"]].corr().iloc[0,1])\n",
        "print(f\"Resumen: hoteles={len(hot)} | Δ promedio={hot['delta'].mean():+.4f} | \"\n",
        "      f\"Δ mediana={hot['delta'].median():+.4f} | corr(Δ, n)={corr_delta_n:+.3f}\")\n",
        "print(f\"Usuarios etiquetados: severos={(user_stats['tipo']=='Severo (z≤-2)').sum()}, \"\n",
        "      f\"benévolos={(user_stats['tipo']=='Benévolo (z≥2)').sum()}, \"\n",
        "      f\"neutrales={(user_stats['tipo']=='Neutral').sum()}\")\n"
      ],
